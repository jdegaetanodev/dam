{
  "expo": {
    "name": "Reportes Urbanos",
    "slug": "mi-app-incidentes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B3A5D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ar.edu.uner.incidentes"
    },
    "android": {
      "package": "ar.edu.uner.incidentes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}